rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId;
    }

    function isOrgMember(orgId) {
      return isSignedIn() && userOrgId() == orgId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow write: if false;

      match /products/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /rawMaterials/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /recipes/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /purchases/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /production/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /sales/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /expenses/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /wastage/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /returns/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /inventoryMovements/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /dailySummaries/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }

      match /importSavedMappings/{document=**} {
        allow read: if isOrgMember(orgId);
        allow write: if false;
      }
    }
  }
}
